<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Livetextning (Fullskärmsläge aktivt)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Grundläggande stil */
        body {
            background-color: #111;
            color: white;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-content: flex-end; /* Justera mot botten initialt */
            align-items: center;
            min-height: 100vh;
            overflow-y: auto;
            transition: background-color 0.3s ease; /* Mjuk övergång */
        }

        /* Undertextbehållare */
        #subtitles-container {
            background-color: rgba(0, 0, 0, 0.8);
            padding: 1.5rem 2.5rem;
            border-radius: 10px;
            text-align: center;
            width: 85%;
            max-width: 1200px;
            margin-bottom: 2vh;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            min-height: 10vh;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-grow: 1; /* Låt den växa initialt */
            margin-top: 2vh;
            transition: all 0.3s ease; /* Mjuk övergång för storlek/position */
        }
        #transcript {
            font-size: 3.5vw;
            line-height: 1.4;
            font-weight: 500;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.7);
            margin: 0;
            max-height: 60vh; /* Maxhöjd initialt */
            overflow-y: auto;
            width: 100%; /* Ta upp hela bredden av containern */
            transition: max-height 0.3s ease;
        }

        /* Wrapper för kontroller och ordlista */
         #controls-wrapper {
            width: 90%;
            max-width: 800px;
            margin-bottom: 3vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            transition: opacity 0.3s ease, visibility 0.3s ease; /* Mjuk övergång för döljning */
         }
         #controls {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
            align-items: center;
            width: 100%;
            position: relative; /* För status */
        }
         #custom-words-container {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
         }
         #customWords {
            width: 100%; padding: 10px; font-size: 0.9rem; border-radius: 5px;
            border: 1px solid #555; background-color: #222; color: white;
            min-height: 60px; resize: vertical;
         }
         #custom-words-container label { font-size: 0.9rem; color: #ccc; }

        /* Status */
        #status {
            order: 99; width: 100%; text-align: center; margin-top: 10px;
            background-color: rgba(255, 255, 255, 0.1); color: #ccc; padding: 3px 8px;
            border-radius: 5px; font-size: 0.75rem; white-space: nowrap;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

        /* --- Fullskärmsläge när aktiv --- */
        body.fullscreen-active {
            justify-content: flex-start; /* Justera mot toppen för att ge plats åt text */
            background-color: #000; /* Helt svart bakgrund */
        }
        body.fullscreen-active #subtitles-container {
            width: 98%; /* Nästan full bredd */
            height: calc(100vh - 80px); /* Nästan full höjd, lämna plats för kontroller */
            max-width: none; /* Ta bort max bredd */
            margin-top: 1vh;
            margin-bottom: 70px; /* Utrymme ovanför de fixerade kontrollerna */
            border-radius: 5px; /* Mindre rundning i fullskärm */
            box-shadow: none; /* Ta bort skugga */
            background-color: rgba(0, 0, 0, 0.6); /* Något mindre opacitet? */
        }
         body.fullscreen-active #transcript {
             font-size: 4vw; /* Något större text i fullskärm */
             max-height: 100%; /* Ta upp hela containerhöjden */
         }

        body.fullscreen-active #controls-wrapper {
            /* Dölj hela wrapper initialt, vi visar bara specifika knappar nedan */
             opacity: 0;
             visibility: hidden;
             height: 0;
             overflow: hidden;
             margin-bottom: 0; /* Ta bort marginal */
             gap: 0;
        }

        /* Flytta och visa endast nödvändiga kontroller i fullskärmsläge */
        #active-controls {
            position: fixed; /* Fixerad position i botten */
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            display: none; /* Dold initialt */
            gap: 20px;
            padding: 8px 15px;
            background-color: rgba(30, 30, 30, 0.8); /* Mörk bakgrund för kontroller */
            border-radius: 8px;
            z-index: 100; /* Se till att de är överst */
            transition: opacity 0.3s ease;
        }
         body.fullscreen-active #active-controls {
             display: flex; /* Visa när fullskärm är aktiv */
         }
         /* Flytta relevanta knappar till den aktiva kontrollbaren */
         body.fullscreen-active #startButton,
         body.fullscreen-active #pauseButton {
             /* Dessa knappar kommer att renderas inuti #active-controls via JS */
             margin: 0; /* Nollställ ev. marginaler */
         }
         body.fullscreen-active #saveSrtButton,
         body.fullscreen-active #languageSelect,
         body.fullscreen-active #status {
             display: none !important; /* Göm Spara, Språkval och Status helt */
         }


        /* Anpassning för mindre skärmar */
        @media (max-width: 768px) {
            #transcript { font-size: 5vw; }
            body.fullscreen-active #transcript { font-size: 6vw; } /* Ännu större på mobil */
            #subtitles-container { width: 95%; padding: 1rem 1.5rem; margin-bottom: 1vh; }
            #controls-wrapper { margin-bottom: 2vh; gap: 15px;}
            #controls { gap: 10px; }
            .control-button, #languageSelect, #customWords { padding: 8px 10px !important; font-size: 0.85rem !important; }
            #status { font-size: 0.7rem; }
            #customWords { min-height: 50px; }
            #active-controls { gap: 15px; }
        }

         /* Knappstil */
        .control-button {
            padding: 10px 20px; font-size: 1rem; color: white; border: none;
            border-radius: 5px; cursor: pointer; box-shadow: 0 2px 5px rgba(0,0,0,0.3);
            transition: background-color 0.3s ease, opacity 0.3s ease;
        }
        .control-button:disabled { opacity: 0.5; cursor: not-allowed; }

        /* Språkvals-stil */
        #languageSelect {
            padding: 10px 15px; font-size: 1rem; border-radius: 5px; border: 1px solid #555;
            background-color: #333; color: white; cursor: pointer; box-shadow: 0 2px 5px rgba(0,0,0,0.3);
            transition: background-color 0.3s ease;
        }
        #languageSelect:hover { background-color: #444; }
        #languageSelect:disabled { opacity: 0.5; cursor: not-allowed; }

        /* Färger för knappar */
        #startButton { background-color: #4CAF50; }
        #startButton:hover:not(:disabled) { background-color: #45a049; }
        #startButton.active { background-color: #f44336; } /* Röd när aktiv (Stopp) */
        #startButton.active:hover:not(:disabled) { background-color: #da190b; }
        #pauseButton { background-color: #ff9800; }
        #pauseButton:hover:not(:disabled) { background-color: #f57c00; }
        #pauseButton.paused { background-color: #2196F3; } /* Blå när pausad (Återuppta) */
        #pauseButton.paused:hover:not(:disabled) { background-color: #1976D2; }
        #saveSrtButton { background-color: #607D8B; }
        #saveSrtButton:hover:not(:disabled) { background-color: #546E7A; }

    </style>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
    <div id="subtitles-container">
        <p id="transcript">Väntar på tal...</p>
    </div>

    <div id="controls-wrapper">
        <div id="controls">
            <label for="languageSelect" class="sr-only">Välj språk:</label>
            <select id="languageSelect" title="Välj igenkänningsspråk">
                <option value="sv-SE">Svenska</option>
                <option value="en-US">Engelska (US)</option>
                <option value="en-GB">Engelska (UK)</option>
                <option value="de-DE">Tyska</option>
                <option value="fr-FR">Franska</option>
                <option value="es-ES">Spanska</option>
                <option value="it-IT">Italienska</option>
                <option value="ja-JP">Japanska</option>
                <option value="ko-KR">Koreanska</option>
                <option value="zh-CN">Kinesiska (Mandarin)</option>
            </select>
            <button id="startButton" class="control-button">Starta</button>
            <button id="pauseButton" class="control-button" disabled>Pausa</button>
            <button id="saveSrtButton" class="control-button" disabled>Spara SRT</button>
            <div id="status">Status: Inaktiv</div>
        </div>
        <div id="custom-words-container">
            <label for="customWords">Förbättra igenkänning (ett ord/namn per rad):</label>
            <textarea id="customWords" rows="4" placeholder="T.ex. Kista Mässan, specifika namn, facktermer..."></textarea>
        </div>
    </div>

    <div id="active-controls">
        </div>


    <script>
        // Hämta HTML-element
        const transcriptElement = document.getElementById('transcript');
        const statusElement = document.getElementById('status'); // Fortfarande kvar, men dold i CSS
        const startButton = document.getElementById('startButton');
        const pauseButton = document.getElementById('pauseButton');
        const saveSrtButton = document.getElementById('saveSrtButton');
        const languageSelect = document.getElementById('languageSelect');
        const customWordsTextarea = document.getElementById('customWords');
        const controlsWrapper = document.getElementById('controls-wrapper'); // För att dölja/visa
        const activeControlsContainer = document.getElementById('active-controls'); // Ny container

        // Kontrollera om Web Speech API stöds
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        let recognition = null;
        let isRecognizing = false;
        let isPaused = false;
        let startTime = 0;
        let srtSegments = [];
        let accumulatedFinalTranscript = '';

        function escapeRegExp(string) { /* ... (oförändrad) ... */
            return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
         }
        function applyCustomWords(text) { /* ... (oförändrad) ... */
            const customWordsRaw = customWordsTextarea.value.trim();
            if (!customWordsRaw) { return text; }
            const customWords = customWordsRaw.split('\n').map(word => word.trim()).filter(word => word.length > 0);
            if (customWords.length === 0) { return text; }
            let processedText = text;
            customWords.forEach(word => {
                try {
                    const regex = new RegExp(`\\b${escapeRegExp(word)}\\b`, 'gi');
                    processedText = processedText.replace(regex, match => word);
                } catch (e) { console.warn(`Kunde inte skapa regex för ordet: "${word}"`, e); }
            });
            return processedText;
         }
        function formatTimeSRT(milliseconds) { /* ... (oförändrad) ... */
            if (milliseconds < 0) milliseconds = 0;
            const totalSeconds = Math.floor(milliseconds / 1000);
            const ms = String(milliseconds % 1000).padStart(3, '0');
            const seconds = String(totalSeconds % 60).padStart(2, '0');
            const totalMinutes = Math.floor(totalSeconds / 60);
            const minutes = String(totalMinutes % 60).padStart(2, '0');
            const hours = String(Math.floor(totalMinutes / 60)).padStart(2, '0');
            return `${hours}:${minutes}:${seconds},${ms}`;
        }
        function generateSrtContent(segments) { /* ... (oförändrad) ... */
             let srt = '';
            segments.forEach((segment, index) => {
                const startTimeFormatted = formatTimeSRT(segment.startTimeMs);
                const endTimeFormatted = formatTimeSRT(segment.endTimeMs);
                const validEndTimeFormatted = segment.endTimeMs >= segment.startTimeMs ? endTimeFormatted : startTimeFormatted;
                srt += `${index + 1}\n${startTimeFormatted} --> ${validEndTimeFormatted}\n${segment.text}\n\n`;
            });
            return srt;
         }
        function downloadFile(content, fileName, contentType) { /* ... (oförändrad) ... */
            const blob = new Blob([content], { type: contentType });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob); a.download = fileName;
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            URL.revokeObjectURL(a.href);
         }

        // Funktion för att flytta knappar mellan kontroller
        function moveControls(toActive) {
            if (toActive) {
                // Flytta Start/Stopp och Paus till #active-controls
                activeControlsContainer.appendChild(startButton);
                activeControlsContainer.appendChild(pauseButton);
            } else {
                // Flytta tillbaka till ursprunglig plats (#controls)
                // Hitta en referenspunkt (t.ex. Spara-knappen)
                const referenceNode = saveSrtButton;
                 if (controlsWrapper.querySelector('#controls')) { // Säkerställ att #controls finns
                    controlsWrapper.querySelector('#controls').insertBefore(pauseButton, referenceNode);
                    controlsWrapper.querySelector('#controls').insertBefore(startButton, pauseButton);
                 }
            }
        }


        if (SpeechRecognition) {
            recognition = new SpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = true;
            recognition.lang = languageSelect.value;

            statusElement.textContent = 'Status: Redo';

            recognition.onstart = () => {
                if (!isPaused) { startTime = Date.now(); }
                isRecognizing = true;
                isPaused = false;
                statusElement.textContent = `Status: Lyssnar (${recognition.lang})...`; // Dold men uppdaterad
                startButton.textContent = 'Stoppa';
                startButton.classList.add('active');
                pauseButton.textContent = 'Pausa';
                pauseButton.classList.remove('paused');
                pauseButton.disabled = false;
                // saveSrtButton, languageSelect, customWordsTextarea döljs av CSS
                document.body.classList.add('fullscreen-active'); // Aktivera fullskärmsläge
                moveControls(true); // Flytta knappar till aktiv bar
                console.log(`Taligenkänning startad/återupptagen med språk: ${recognition.lang}`);
            };

            recognition.onresult = (event) => {
                 let interimTranscript = '';
                let currentFinalTranscriptSegment = '';
                let segmentEndTime = Date.now();

                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    const transcriptPart = event.results[i][0].transcript;
                    if (event.results[i].isFinal) {
                        currentFinalTranscriptSegment += transcriptPart.trim() + '. ';
                    } else {
                        interimTranscript += transcriptPart;
                    }
                }

                if (currentFinalTranscriptSegment) {
                    const correctedSegment = applyCustomWords(currentFinalTranscriptSegment);
                    accumulatedFinalTranscript += correctedSegment;
                    const segmentStartTime = srtSegments.length > 0 ? srtSegments[srtSegments.length - 1].endTimeMs : 0;
                    const elapsedTimeMs = segmentEndTime - startTime;
                    srtSegments.push({ text: correctedSegment.trim(), startTimeMs: segmentStartTime, endTimeMs: elapsedTimeMs });
                    // saveSrtButton är dold, men vi kan fortfarande aktivera den logiskt
                    // saveSrtButton.disabled = false;
                }

                transcriptElement.textContent = accumulatedFinalTranscript + interimTranscript;
                 if (transcriptElement.scrollHeight > transcriptElement.clientHeight) {
                    transcriptElement.scrollTop = transcriptElement.scrollHeight;
                }
             };

            recognition.onend = () => {
                console.log('Taligenkänning avslutad (onend). isRecognizing:', isRecognizing, 'isPaused:', isPaused);
                const wasRunning = isRecognizing && !isPaused;

                // Om vi inte stoppat manuellt eller pausat, försök starta om
                // (Behåll fullskärmsläget under omstart)
                if (wasRunning) {
                    try {
                        recognition.lang = languageSelect.value;
                        recognition.start();
                        // statusElement.textContent = `Status: Startar om (${recognition.lang})...`; // Dold
                        console.log(`Taligenkänning startades om automatiskt med språk: ${recognition.lang}`);
                    } catch(e) {
                        console.error("Kunde inte starta om automatiskt:", e);
                        // statusElement.textContent = 'Status: Omstart misslyckades'; // Dold
                        resetToInactiveState(); // Återställ helt om omstart misslyckas
                    }
                } else if (!isRecognizing && !isPaused) {
                    // Om vi har stoppat manuellt eller pausat och sedan stoppat
                    resetToInactiveState();
                }
                 // Om bara pausad, gör ingenting här, vänta på resume eller stopp
            };

            recognition.onerror = (event) => {
                console.error('Taligenkänningsfel:', event.error, 'Språk:', recognition.lang);
                // statusElement.textContent = `Fel: ${event.error}`; // Dold
                let alertMsg = null;
                const currentLang = languageSelect.options[languageSelect.selectedIndex].text;

                // ... (felhanteringslogik som tidigare, men status är dold) ...
                 if (event.error === 'no-speech') {
                    // statusElement.textContent = `Fel: Ingen tal uppfattades (${currentLang}).`;
                    if (isRecognizing && !isPaused) {
                        try { recognition.start(); console.log('Försöker starta om efter "no-speech".'); return; }
                        catch(e) { console.error("Kunde inte starta om efter no-speech:", e); }
                    }
                } else if (event.error === 'audio-capture') {
                     // statusElement.textContent = 'Fel: Mikrofonproblem.';
                     alertMsg = "Kunde inte komma åt mikrofonen. Kontrollera att du gett tillåtelse och att mikrofonen fungerar.";
                } else if (event.error === 'not-allowed') {
                    // statusElement.textContent = 'Fel: Åtkomst nekad.';
                    alertMsg = "Du behöver ge tillåtelse till mikrofonen för att textning ska fungera.";
                } else if (event.error === 'language-not-supported') {
                     // statusElement.textContent = `Fel: Språket ${currentLang} stöds inte.`;
                     alertMsg = `Det valda språket (${currentLang} / ${recognition.lang}) stöds inte av din webbläsares taligenkänning.`;
                } else if (event.error === 'service-not-allowed') {
                     // statusElement.textContent = 'Fel: Tjänst nekad.';
                     alertMsg = "Webbläsaren blockerade taligenkänningstjänsten. Detta kan bero på nätverksinställningar eller tillägg.";
                 } else {
                    alertMsg = `Ett okänt fel inträffade med taligenkänningen (${currentLang}): ${event.error}`;
                }

                resetToInactiveState(); // Återställ alltid vid fel
                if (alertMsg) { alert(alertMsg); }
            };

            // --- Knapplogik ---

            startButton.onclick = () => {
                if (isRecognizing) { // Stoppa
                    isRecognizing = false; isPaused = false; recognition.stop();
                    console.log('Försöker stoppa igenkänning (manuell stopp)...');
                    // resetToInactiveState anropas från onend
                } else { // Starta
                    try {
                        accumulatedFinalTranscript = ''; srtSegments = [];
                        transcriptElement.textContent = "Startar textning...";
                        recognition.lang = languageSelect.value;
                        recognition.start();
                        // onstart hanterar UI-ändringar
                    } catch (e) {
                        console.error("Kunde inte starta igenkänning:", e);
                        // statusElement.textContent = 'Fel: Kunde inte starta.'; // Dold
                        alert("Kunde inte starta taligenkänningen. Försök igen.");
                        resetToInactiveState();
                    }
                }
            };

            pauseButton.onclick = () => {
                if (!isRecognizing) return;
                if (isPaused) { // Återuppta
                    try {
                        recognition.lang = languageSelect.value;
                        recognition.start(); // onstart hanterar UI
                        // statusElement.textContent = `Status: Återupptar (${recognition.lang})...`; // Dold
                        console.log(`Försöker återuppta igenkänning med språk: ${recognition.lang}`);
                    } catch (e) {
                         console.error("Kunde inte återuppta igenkänning:", e);
                         // statusElement.textContent = 'Fel: Kunde inte återuppta.'; // Dold
                         alert("Kunde inte återuppta taligenkänningen.");
                         resetToInactiveState();
                    }
                } else { // Pausa
                    isPaused = true; recognition.stop(); // Stoppar tillfälligt
                    // statusElement.textContent = 'Status: Pausad'; // Dold
                    pauseButton.textContent = 'Återuppta'; // Uppdatera knapptext
                    pauseButton.classList.add('paused');
                    // Språk och ordlista är redan dolda av CSS
                    console.log('Försöker pausa igenkänning...');
                }
            };

            // Spara-knappen är nu dold i aktivt läge, men funktionen finns kvar
             saveSrtButton.onclick = () => {
                if (srtSegments.length === 0) { alert("Det finns ingen transkription att spara."); return; }
                const srtContent = generateSrtContent(srtSegments);
                const langCode = languageSelect.value.split('-')[0];
                downloadFile(srtContent, `transkription_${langCode}.srt`, 'application/x-subrip');
                console.log('SRT-fil genererad och nedladdning startad.');
            };


            // Språkvalslogik (körs även om select är dold, ifall värdet ändras programmatiskt)
            languageSelect.onchange = () => {
                const newLang = languageSelect.value;
                console.log(`Språk ändrat till: ${newLang}`);
                recognition.lang = newLang;
                // Om igenkänning körs (men select är dold), starta om för att tillämpa
                if (isRecognizing && !isPaused) {
                    console.log('Startar om igenkänning på grund av språkbyte...');
                    recognition.stop(); // onend hanterar omstart
                    // statusElement.textContent = `Status: Byter språk till ${newLang}...`; // Dold
                } else if (isPaused) {
                     // statusElement.textContent = `Status: Pausad (språk ändrat till ${newLang})`; // Dold
                }
            };

        } else {
            // Om Web Speech API inte stöds
            transcriptElement.textContent = 'Din webbläsare stöder inte taligenkänning.';
            statusElement.textContent = 'Fel: API stöds ej';
            startButton.disabled = true; pauseButton.disabled = true; saveSrtButton.disabled = true;
            languageSelect.disabled = true; customWordsTextarea.disabled = true;
            alert('Web Speech API stöds inte av den här webbläsaren. Prova Google Chrome.');
        }

        // --- Hjälpfunktioner ---

        function resetToInactiveState() {
            isRecognizing = false; isPaused = false;
            document.body.classList.remove('fullscreen-active'); // Ta bort fullskärmsläge
            moveControls(false); // Flytta tillbaka knappar
            statusElement.textContent = 'Status: Inaktiv'; // Visa status igen
            startButton.textContent = 'Starta'; startButton.classList.remove('active');
            pauseButton.textContent = 'Pausa'; pauseButton.classList.remove('paused'); pauseButton.disabled = true;
            saveSrtButton.disabled = srtSegments.length === 0; // Återställ spara-knappens status
            languageSelect.disabled = false;
            customWordsTextarea.disabled = false;
            console.log('Återställd till inaktivt läge.');
        }

    </script>
</body>
</html>
